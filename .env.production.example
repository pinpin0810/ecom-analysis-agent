# Copy to .env.production on the server and replace every placeholder.
# Quote URL values if passwords contain characters that need URL encoding.
DATA_BASE_URL=mysql+pymysql://APP_USER:URL_ENCODED_PASSWORD@DB_HOST:3306/APP_DATABASE?charset=utf8mb4
QUERY_DATA_BASE_URL=mysql+pymysql://READ_ONLY_USER:URL_ENCODED_PASSWORD@DB_HOST:3306/APP_DATABASE?charset=utf8mb4

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_MODEL=REPLACE_WITH_MODEL_NAME
LLM_TIMEOUT_SECONDS=60
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=15
CHROMA_COLLECTION=ecom_texts

# Comma-separated browser origins, for example https://shop.example.com
CORS_ORIGINS=https://YOUR_DOMAIN
